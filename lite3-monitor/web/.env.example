# Copy to .env.local (git-ignored). Read at runtime by /api/config - no rebuild needed.
# Websocket URL of the bridge. With the SSH tunnel this is the local end of the tunnel.
LITE3_BRIDGE_WS_URL=ws://127.0.0.1:8765/ws
# If set, the dashboard shows IDENTITY MISMATCH and hides robot data when the
# bridge reports a different hostname / ROS_DOMAIN_ID (live mode only).
LITE3_EXPECTED_HOSTNAME=
LITE3_EXPECTED_DOMAIN_ID=
# Where monitoring sessions are stored (default: ./data/history).
LITE3_HISTORY_DIR=
