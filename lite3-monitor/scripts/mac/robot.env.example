# Copy to robot.env (git-ignored) and fill in. NOTHING here is guessed:
# confirm every value with your team before live use.
NUC_HOST=            # IP or hostname of OUR NUC on the school Wi-Fi
NUC_USER=            # SSH username on the NUC
NUC_SSH_PORT=22
# Optional: an SSH key or ~/.ssh/config Host alias can replace the two lines above.
# NUC_SSH_TARGET=lite3-nuc

# Port forwarding: Mac 127.0.0.1:LOCAL_PORT -> NUC 127.0.0.1:REMOTE_PORT
LOCAL_PORT=8765
REMOTE_PORT=8765

# Identity checks enforced by the dashboard (must match what the bridge reports).
EXPECTED_HOSTNAME=   # output of `hostname` on the NUC
EXPECTED_DOMAIN_ID=  # our ROS_DOMAIN_ID

# Workspace on the NUC that defines any custom message types (sourced read-only).
NUC_LITE3_WS=~/lite3_ws
# Where the bridge is deployed on the NUC (only after approval).
NUC_INSTALL_DIR=~/lite3-monitor
# Where start-all looks for the monitor on the NUC (git clone location).
NUC_MONITOR_DIR=~/Lite3_Monitoring_Dashboard/lite3-monitor
